            <span style="background:var(--color-accent);color:var(--color-accent-on);font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;">PL</span>
            <span style="font-weight:700;font-size:16px;letter-spacing:-0.01em;">POSTERLEAGUE</span>
          </a>
          <p style="font-size:13px;line-height:1.6;color:#8E8E8E;max-width:300px;margin-bottom:0;">
            Premium 300gsm laminated prints &amp; custom wall art. Made to order with love.
          </p>
          {% render 'social-icons' %}
        </div>

        <!-- Col 2: Shop -->
        <div>
          <h4>Shop</h4>
