          <h4>Help</h4>
          <ul>
            <li><a href="/pages/about">About Us</a></li>
            <li><a href="/pages/faq">FAQ</a></li>
            <li><a href="/pages/shipping">Shipping Policy</a></li>
            <li><a href="/pages/returns">Returns &amp; Refunds</a></li>
            <li><a href="/pages/custom-quote">Custom Order Quote</a></li>
          </ul>
        </div>

        <!-- Col 4: Newsletter -->
        <div>
          <h4>{{ 'footer.newsletter_title' | t }}</h4>
          <p style="font-size:12.5px;line-height:1.5;color:#8E8E8E;margin-bottom:14px;">
            {{ 'footer.newsletter_subtitle' | t }}
          </p>
          <form method="post" action="/contact#contact_form" id="contact_form" accept-charset="UTF-8">
            <input type="hidden" name="form_type" value="customer">
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div style="display:flex;gap:8px;">
              <input type="email" name="contact[email]" placeholder="Your email address" required style="flex:1;background:#1E1E1E;border:1px solid #333333;color:#FFFFFF;padding:10px 12px;font-size:12.5px;border-radius:6px;">
              <button type="submit" class="btn btn--amber btn--sm" style="flex-shrink:0;">{{ 'footer.newsletter_button' | t }}</button>
