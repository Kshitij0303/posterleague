<div class="section section--dark" style="padding: 64px 0; background: var(--color-hero-bg); color: var(--color-hero-text);">
  <div class="container" style="max-width: 600px; text-align: center;">
    <h2 style="margin: 0 0 16px;">{{ section.settings.heading | escape }}</h2>
    <p style="opacity: 0.75; margin: 0 0 32px;">{{ section.settings.subheading | escape }}</p>
    
    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form__fields">
        <input type="text" name="contact[first_name]" placeholder="First Name" aria-label="First Name" required>
        <input type="email" name="contact[email]" placeholder="Email Address" aria-label="Email Address" required>
        <button type="submit" class="btn btn--primary">Subscribe</button>
      </div>
      {% if form.posted_successfully? %}
        <p class="form-success" style="margin-top: 16px; color: #4caf50;">Thanks for subscribing!</p>
      {% endif %}
      {% if form.errors %}
        <p class="form-error" style="margin-top: 16px; color: var(--color-accent);">{{ form.errors | default_errors }}</p>
      {% endif %}
    {% endform %}
    <p style="margin-top: 16px; font-size: 12px; color: rgba(244,241,235,0.5);">We respect your privacy. No spam.</p>
  </div>
</div>

<style>
.newsletter-form__fields { display: flex; flex-direction: column; gap: 12px; }
@media(min-width: 600px) {
  .newsletter-form__fields { flex-direction: row; }
}
.newsletter-form input { flex: 1; padding: 12px 16px; border: 1px solid rgba(255,255,255,0.2); background: transparent; color: white; border-radius: 2px; font-family: inherit; }
.newsletter-form input::placeholder { color: rgba(255,255,255,0.5); }
.newsletter-form input:focus { outline: none; border-color: white; }
.newsletter-form button { white-space: nowrap; }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the Loop"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "New drops, custom order updates, and early access — straight to your inbox."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
