{% comment %}
  Reusable homepage category row — horizontally-scrollable 2-row product
  rail for a single collection. Add one instance per category (Posters,
  Splits, Stickers, Bookmarks, Magnets, Trading Cards).
{% endcomment %}

<div class="section">
  <div class="container">
    {% assign empty_title = section.settings.heading | append: ' — coming soon' %}
    {% render 'product-rail',
      rail_id: section.id,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      products: section.settings.collection.products,
      products_count: section.settings.collection.products_count,
      limit: section.settings.products_to_show,
      view_all_url: section.settings.collection.url,
      show_view_all: section.settings.show_view_all,
      empty_title: empty_title,
      empty_text: section.settings.empty_text
    %}
  </div>
</div>

{% schema %}
{
  "name": "Category Row",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Posters"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 20,
      "step": 2,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All link",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Message shown when the collection has no products yet",
      "default": "We are still stocking this category — check back soon."
    }
  ],
  "presets": [
    {
      "name": "Category Row"
    }
  ]
}
{% endschema %}
