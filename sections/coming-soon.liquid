<section id="coming-soon" class="section section--dark">
  <div class="container">
    <div class="section__header" style="color: white; text-align: center; margin-bottom: 48px;">
      <h2 class="section__title" style="color: white; margin: 0 0 16px;">{{ section.settings.heading | escape }}</h2>
      <p class="section__subtitle" style="opacity: 0.75;">{{ section.settings.subheading | escape }}</p>
    </div>
    <div class="grid-2col" style="display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
      {% for block in section.blocks %}
        <div class="teaser-card" {{ block.shopify_attributes }}>
          <div class="teaser-card__image">
            {% if block.settings.image %}
              <img 
                src="{{ block.settings.image | image_url: width: 1200 }}" 
                srcset="{{ block.settings.image | image_url: width: 600 }} 600w,
                        {{ block.settings.image | image_url: width: 900 }} 900w,
                        {{ block.settings.image | image_url: width: 1200 }} 1200w,
                        {{ block.settings.image | image_url: width: 1600 }} 1600w"
                sizes="(min-width: 1024px) 50vw, 100vw"
                alt="{{ block.settings.title | escape }}" 
                loading="lazy" 
                width="1200" 
                height="675"
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {% else %}
              <div class="teaser-card__placeholder"></div>
            {% endif %}
            <span class="badge badge--coming-soon">{{ block.settings.expected_text | escape }}</span>
          </div>
          <div class="teaser-card__content">
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.description | escape }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
    <p style="text-align: center; margin-top: 48px; color: rgba(255,255,255,0.6); font-size: 14px;">Want to be first to know? Subscribe to our newsletter below.</p>
  </div>
</section>

<style>
.section--dark { background-color: #0c0c0c; color: white; padding: 64px 0; }
.teaser-card { border: 1px solid rgba(255,255,255,0.2); border-radius: 2px; overflow: hidden; background: #111; }
.teaser-card__image { position: relative; width: 100%; aspect-ratio: 16/9; background: #222; }
.teaser-card__image img { width: 100%; height: 100%; object-fit: cover; }
.teaser-card__placeholder { width: 100%; height: 100%; }
.badge--coming-soon { position: absolute; top: 16px; right: 16px; background: var(--color-accent); color: var(--color-text); padding: 4px 8px; font-size: 12px; font-weight: bold; border-radius: 2px; text-transform: uppercase; letter-spacing: 0.05em; }
.teaser-card__content { padding: 24px; }
.teaser-card__content h3 { font-family: 'Cormorant', Georgia, serif; font-size: 26px; color: white; margin: 0 0 8px; font-weight: 600; }
.teaser-card__content p { color: rgba(255,255,255,0.6); margin: 0; font-size: 15px; }
</style>

{% schema %}
{
  "name": "Coming Soon",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Coming Soon"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "More ways to fill your walls."
    }
  ],
  "blocks": [
    {
      "type": "coming_soon_item",
      "name": "Coming Soon Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "expected_text",
          "label": "Expected Text",
          "default": "Coming 2025"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coming Soon",
      "blocks": [
        { "type": "coming_soon_item", "settings": { "title": "Frames", "description": "Premium frames for your prints.", "expected_text": "Coming 2025" } },
        { "type": "coming_soon_item", "settings": { "title": "Metal Art", "description": "Brushed metal finish wall art.", "expected_text": "Coming 2025" } }
      ]
    }
  ]
}
{% endschema %}


