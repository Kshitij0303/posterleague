<div class="section" style="background-color: var(--color-bg-secondary); padding: 64px 0;">
  <div class="container">
    <div class="section__header" style="text-align: center; margin-bottom: 40px;">
      <h2 class="section__title">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="grid-3col" style="display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
      {% for block in section.blocks %}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="review-card__stars">
            {% assign rating = block.settings.rating | times: 1 %}
            {% for i in (1..5) %}
              <span style="color: {% if i <= rating %}#FFB800{% else %}#D8D5CE{% endif %}; font-size: 20px;">&#9733;</span>
            {% endfor %}
          </div>
          <p class="review-card__quote">"{{ block.settings.quote | escape }}"</p>
          <div class="review-card__author-info">
            <strong>{{ block.settings.author | escape }}</strong>
            {% if block.settings.location != blank %}
              <span class="review-card__location">, {{ block.settings.location | escape }}</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
.review-card { background: var(--color-bg); border: 1px solid var(--color-border); padding: 24px; border-radius: 2px; }
.review-card__stars { margin-bottom: 16px; }
.review-card__quote { font-style: italic; font-size: 16px; line-height: 1.5; color: var(--color-text); margin: 0 0 16px; }
.review-card__author-info { font-size: 14px; }
.review-card__location { color: var(--color-text-muted); }
</style>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Customers Say"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location (Optional)"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "The print quality is amazing. Exactly what I wanted.", "author": "Alex D.", "location": "Mumbai", "rating": 5 } },
        { "type": "review", "settings": { "quote": "Super easy custom process. Got my quote fast.", "author": "Sam K.", "location": "Delhi", "rating": 5 } },
        { "type": "review", "settings": { "quote": "Thick paper, great colors.", "author": "Jordan P.", "rating": 4 } }
      ]
    }
  ]
}
{% endschema %}

