<div class="section" style="padding: 48px 0 80px;">
  <div class="container" style="max-width: 800px; margin: 0 auto;">
    <h1 style="margin: 0 0 28px; font-size: 32px; font-weight: 700; text-align: center; letter-spacing: -0.02em;">{{ page.title }}</h1>
    <div class="rte" style="line-height: 1.7; color: #333333; font-size: 15px;">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page"
}
{% endschema %}
