{%- liquid
  assign default_handles = 'posters,stickers,bookmarks,magnets,splits,trading-cards' | split: ','
  assign default_descriptions = 'A5, A3 & A4 — 300gsm laminated|Custom printed — 300gsm laminated|300gsm laminated & durable|Fridge-ready custom magnets|3, 4 & 8-Piece Sets|3x4 format — 300gsm laminated' | split: '|'
-%}

<div class="section pl-categories">
  <div class="container">
    <div class="section__header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
      <h2 style="font-size:28px;margin:0;">{{ section.settings.heading | escape }}</h2>
      <a href="/collections/all" style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--color-text-muted);text-decoration:none;">View All &rarr;</a>
    </div>

    <div class="category-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px;">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {%- liquid
            assign block_collection = blank
            if block.settings.link != blank and block.settings.link contains '/collections/'
              assign link_handle = block.settings.link | split: '/collections/' | last | split: '/' | first | split: '?' | first
              assign block_collection = collections[link_handle]
            endif
          -%}
          {% render 'category-card',
            title: block.settings.title,
            description: block.settings.description,
            link: block.settings.link,
            image: block.settings.image,
            collection: block_collection,
            shopify_attributes: block.shopify_attributes
          %}
        {% endfor %}
      {% else %}
        {% for handle in default_handles %}
          {%- assign coll = collections[handle] -%}
          {%- assign desc_index = forloop.index0 -%}
          {% render 'category-card',
            title: coll.title,
            description: default_descriptions[desc_index],
            link: coll.url,
            image: blank,
            collection: coll
          %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<style>
@media (min-width: 768px) { .category-grid { grid-template-columns: repeat(3, 1fr) !important; } }
@media (min-width: 1024px) { .category-grid { grid-template-columns: repeat(6, 1fr) !important; gap: 14px !important; } }
.cat-card:hover img { transform: scale(1.06); }
</style>

{% schema %}
{
  "name": "Product Categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop By Category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image (portrait 3:4)" },
        { "type": "text", "id": "description", "label": "Short Description" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Product Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Posters", "link": "/collections/posters", "description": "A5, A3 & A4" } },
        { "type": "category", "settings": { "title": "Stickers", "link": "/collections/stickers", "description": "300gsm laminated" } },
        { "type": "category", "settings": { "title": "Bookmarks", "link": "/collections/bookmarks", "description": "300gsm laminated" } },
        { "type": "category", "settings": { "title": "Magnets", "link": "/collections/magnets", "description": "Custom magnets" } },
        { "type": "category", "settings": { "title": "Splits", "link": "/collections/splits", "description": "3, 4 & 8 piece" } },
        { "type": "category", "settings": { "title": "Trading Cards", "link": "/collections/trading-cards", "description": "3x4 format" } }
      ]
    }
  ]
}
{% endschema %}
