<div class="section">
  <div class="container">
    <div class="custom-promo {% if section.settings.image_position == 'right' %}custom-promo--reverse{% endif %}">
      <div class="custom-promo__image">
        {% if section.blocks.size > 1 %}
          {% render 'promo-carousel', section: section %}
        {% elsif section.settings.image %}
          <img srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                       {{ section.settings.image | image_url: width: 1000 }} 1000w,
                       {{ section.settings.image | image_url: width: 1500 }} 1500w"
               sizes="(min-width: 768px) 50vw, 100vw"
               src="{{ section.settings.image | image_url: width: 1000 }}"
               alt="{{ section.settings.image.alt | default: section.settings.heading }}"
               loading="lazy"
               width="{{ section.settings.image.width }}"
               height="{{ section.settings.image.height }}">
        {% else %}
          <div class="placeholder-box"></div>
        {% endif %}
      </div>
      <div class="custom-promo__content">
        <span class="badge badge--accent">{{ section.settings.eyebrow | escape }}</span>
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        <div class="rte">{{ section.settings.body_text }}</div>
      </div>
    </div>
  </div>
</div>

<style>
.custom-promo { display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center; }
@media(min-width: 768px) {
  .custom-promo { grid-template-columns: 1fr 1fr; gap: 64px; }
  .custom-promo--reverse .custom-promo__image { order: 2; }
  .custom-promo--reverse .custom-promo__content { order: 1; }
}
.custom-promo__image img { width: 100%; height: auto; border-radius: 2px; }
.placeholder-box { width: 100%; aspect-ratio: 4/3; background: var(--color-bg-secondary); border-radius: 2px; }
.badge { text-transform: uppercase; letter-spacing: 0.05em; font-size: 12px; font-weight: bold; }
.badge--accent { color: var(--color-accent); background: var(--color-accent-light); padding: 4px 8px; border-radius: 2px; display: inline-block; margin-bottom: 16px; }
</style>

{% schema %}
{
  "name": "Customization Promo",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image",
      "info": "Only used if fewer than 2 carousel slides (blocks) are added below."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Made For You"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Custom Prints, Your Way"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body Text",
      "default": "<p>Upload your image or idea. We'll handle the rest — 300gsm paper, precision lamination, and a pricing quote sent straight to your inbox. No checkout confusion, no upfront payment for custom work.</p>"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position on Desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "slide_duration",
      "label": "Carousel auto-play interval (seconds)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "carousel_slide",
      "name": "Carousel Slide",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Slide type",
          "options": [
            { "value": "image", "label": "Single image" },
            { "value": "image_grid", "label": "2x2 image grid" },
            { "value": "video", "label": "Video (autoplay, muted, loop)" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (single image slide, or grid image 1)"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Grid image 2"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Grid image 3"
        },
        {
          "type": "image_picker",
          "id": "image_4",
          "label": "Grid image 4"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (Shopify-hosted)"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "External video URL (.mp4)",
          "info": "Used only if no Shopify-hosted video is selected above."
        },
        {
          "type": "checkbox",
          "id": "polaroid_style",
          "label": "Polaroid frame style",
          "default": false
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customization Promo",
      "blocks": [
        { "type": "carousel_slide", "settings": { "media_type": "image", "alt_text": "Custom poster in a premium living room" } },
        { "type": "carousel_slide", "settings": { "media_type": "image_grid" } },
        { "type": "carousel_slide", "settings": { "media_type": "image", "alt_text": "Limited Edition, museum-quality print" } },
        { "type": "carousel_slide", "settings": { "media_type": "image", "alt_text": "300 GSM paper macro with laminated edge" } },
        { "type": "carousel_slide", "settings": { "media_type": "video" } },
        { "type": "carousel_slide", "settings": { "media_type": "image_grid", "polaroid_style": true } }
      ]
    }
  ]
}
{% endschema %}

