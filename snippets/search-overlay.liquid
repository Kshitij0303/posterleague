{% comment %}
  Global search overlay — opens from the header search icon on every page
  and shows results live without navigating. Results are fetched from the
  full search engine via sections/search-overlay-results.liquid (Section
  Rendering API). Logic lives in assets/predictive-search.js;
  main-search.liquid stays as the /search fallback for no-JS visitors and
  direct links.
{% endcomment %}

<div id="search-overlay" class="search-overlay"></div>

<div id="search-panel" class="search-panel" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Search">
  <div class="search-panel__inner">
    <div class="search-panel__bar">
      <form id="PredictiveSearchForm" action="{{ routes.search_url }}" method="get" role="search" class="search-panel__form">
        <input type="hidden" name="type" value="product">
        <div class="t-clear search-panel__field">
          <input
            type="text"
            name="q"
            id="PredictiveSearchInput"
            placeholder="Search posters, stickers..."
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
            aria-label="Search products"
            aria-controls="PredictiveSearchResults"
            aria-expanded="false"
          >
          <div class="t-clear-mirror" aria-hidden="true"></div>
          <div class="t-clear-placeholder" aria-hidden="true">Search posters, stickers...</div>
          <div class="t-clear-glow" aria-hidden="true"></div>
          <button type="button" class="t-clear-btn" aria-label="Clear search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
      </form>
      <button type="button" id="search-panel-close" class="search-panel__close" aria-label="Close search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div class="search-panel__body" id="PredictiveSearchResults" aria-live="polite">
      <p class="search-panel__hint">Start typing to search posters, stickers & more.</p>
    </div>
  </div>
</div>

<style>
  .search-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
    z-index: 10090;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .search-overlay.is-open {
    display: block !important;
    opacity: 1 !important;
  }

  .search-panel {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10091;
    display: flex;
    justify-content: center;
    transform: translateY(-12px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease, visibility 0.25s;
    padding: 0 16px;
  }
  .search-panel.is-open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .search-panel__inner {
    width: 100%;
    max-width: 640px;
    margin-top: min(12vh, 90px);
    background: var(--color-bg-secondary, #fff);
    border-radius: 14px;
    border: 1px solid var(--card-border-color);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    max-height: min(78vh, 640px);
    display: flex;
    flex-direction: column;
  }

  .search-panel__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--card-border-color);
    flex-shrink: 0;
  }

  .search-panel__form {
    flex: 1;
    min-width: 0;
  }

  .search-panel__field input[type="text"] {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    font-size: 16px;
    font-family: inherit;
    color: var(--color-text);
    padding: 8px 2px;
  }

  .search-panel__close {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg, #f4f4f4);
    border: 1px solid var(--card-border-color);
    border-radius: 50%;
    color: var(--color-text);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .search-panel__close:hover {
    background: var(--color-accent-light);
    color: var(--color-accent);
  }

  .search-panel__body {
    overflow-y: auto;
    padding: 8px 8px 16px;
    flex: 1;
  }

  .search-panel__hint,
  .search-panel__empty {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 13.5px;
    padding: 32px 16px;
    margin: 0;
  }

  .search-panel__meta {
    font-size: 12px;
    color: var(--color-text-muted);
    padding: 10px 12px 4px;
    margin: 0;
  }

  .search-panel__loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 32px 16px;
    color: var(--color-text-muted);
    font-size: 13px;
  }

  .search-panel__spinner {
    width: 14px;
    height: 14px;
    border: 2px solid var(--card-border-color);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: search-panel-spin 0.7s linear infinite;
  }

  @keyframes search-panel-spin {
    to { transform: rotate(360deg); }
  }

  .predictive-search__list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .predictive-search__result {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s ease;
  }
  .predictive-search__result:hover,
  .predictive-search__result:focus-visible {
    background: var(--color-bg, #f4f4f4);
  }

  .predictive-search__thumb {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-bg, #f4f4f4);
    border: 1px solid var(--card-border-color);
  }
  .predictive-search__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .predictive-search__info {
    min-width: 0;
    flex: 1;
  }

  .predictive-search__title {
    display: block;
    font-size: 13.5px;
    font-weight: 600;
    margin: 0 0 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .predictive-search__price {
    display: block;
    font-size: 12.5px;
    color: var(--color-text-muted);
  }

  .predictive-search__price s {
    margin-left: 6px;
    opacity: 0.7;
  }

  .search-panel__more {
    display: block;
    width: calc(100% - 16px);
    margin: 10px 8px 0;
    padding: 11px 16px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-bg, #f4f4f4);
    border: 1px solid var(--card-border-color);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .search-panel__more:hover:not(:disabled) {
    background: var(--color-accent-light);
    color: var(--color-accent);
  }
  .search-panel__more:disabled {
    opacity: 0.6;
    cursor: default;
  }

  @media (max-width: 640px) {
    .search-panel { padding: 0; }
    .search-panel__inner {
      max-width: 100%;
      margin-top: 0;
      border-radius: 0;
      max-height: 100vh;
      height: 100%;
    }
  }
</style>
