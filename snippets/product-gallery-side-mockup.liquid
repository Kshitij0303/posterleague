{% comment %}
  Slide 4 — side-angle framed mockup (protected preview).
{% endcomment %}
{%- assign poster = product.featured_image -%}
<div class="pl-side-mockup pl-artwork-protected" role="img" aria-label="{{ product.title | escape }} — side angle mockup">
  <div class="pl-side-mockup__scene">
    {% render 'pl-artwork-watermark' %}
    <div class="pl-side-mockup__frame">
      {% if poster %}
        <img
          class="pl-side-mockup__art"
          src="{{ poster | image_url: width: 1200 }}"
          srcset="{{ poster | image_url: width: 600 }} 600w,
                  {{ poster | image_url: width: 900 }} 900w,
                  {{ poster | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 768px) 45vw, 80vw"
          alt="{{ poster.alt | default: product.title | escape }}"
          loading="lazy"
          decoding="async"
          width="1200"
          height="1600"
          draggable="false"
        >
      {% else %}
        <div class="pl-side-mockup__art pl-side-mockup__art--placeholder" role="presentation"></div>
      {% endif %}
      <div class="pl-side-mockup__edge" aria-hidden="true"></div>
    </div>
    <div class="pl-side-mockup__shadow" aria-hidden="true"></div>
  </div>
</div>

<style>
  .pl-side-mockup {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(155deg, #ECECEF 0%, #D8D8DD 55%, #C8C8CE 100%);
    padding: 24px;
    box-sizing: border-box;
  }

  .pl-side-mockup__scene {
    position: relative;
    width: min(58%, 280px);
    aspect-ratio: 5 / 7;
    perspective: 900px;
  }

  .pl-side-mockup__frame {
    position: relative;
    width: 100%;
    height: 100%;
    transform: rotateY(-22deg) rotateX(4deg);
    transform-style: preserve-3d;
    background: #FFFFFF;
    border-radius: 2px;
    overflow: hidden;
    box-shadow:
      0 2px 0 rgba(255, 255, 255, 0.85) inset,
      0 16px 36px rgba(0, 0, 0, 0.18);
    z-index: 2;
  }

  .pl-side-mockup__art {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pl-side-mockup__art--placeholder {
    background: linear-gradient(145deg, #E8E8ED, #D1D1D6);
    width: 100%;
    height: 100%;
  }

  .pl-side-mockup__edge {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 2px;
    pointer-events: none;
    z-index: 3;
  }

  .pl-side-mockup__shadow {
    position: absolute;
    left: 8%;
    right: -12%;
    bottom: -8%;
    height: 18%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.22) 0%, transparent 72%);
    transform: rotateY(-22deg);
    z-index: 1;
  }

  html[data-theme="dark"] .pl-side-mockup {
    background: linear-gradient(155deg, #1F2833 0%, #151A22 100%);
  }

  html[data-theme="dark"] .pl-side-mockup__frame {
    background: #2A3540;
  }
</style>
