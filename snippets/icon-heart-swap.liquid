{% comment %}
  Animated heart icon — outline (a) / filled gold (b)
  Usage: {% render 'icon-heart-swap', swap_id: 'my-id', swap_state: 'a' %}
{% endcomment %}
{% assign swap_state = swap_state | default: 'a' %}
{% assign icon_size = icon_size | default: 22 %}

<div class="t-icon-swap" data-state="{{ swap_state }}"{% if swap_id != blank %} id="{{ swap_id }}"{% endif %}>
  <span class="t-icon" data-icon="a" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
  </span>
  <span class="t-icon" data-icon="b" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="var(--color-accent)" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
  </span>
</div>
