{% comment %}
  Slide 3 — close-up detail crop of poster artwork (protected preview).
{% endcomment %}
{%- assign poster = product.featured_image -%}
<div class="pl-detail-crop pl-artwork-protected" role="img" aria-label="{{ product.title | escape }} — detail close-up">
  {% if poster %}
    <img
      class="pl-detail-crop__img"
      src="{{ poster | image_url: width: 1600 }}"
      srcset="{{ poster | image_url: width: 800 }} 800w,
              {{ poster | image_url: width: 1200 }} 1200w,
              {{ poster | image_url: width: 1600 }} 1600w"
      sizes="(min-width: 768px) 50vw, 100vw"
      alt="{{ poster.alt | default: product.title | escape }} — detail"
      loading="lazy"
      decoding="async"
      width="1600"
      height="2133"
      draggable="false"
    >
  {% else %}
    <div class="pl-detail-crop__placeholder" role="presentation"></div>
  {% endif %}
</div>

<style>
  .pl-detail-crop {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #12141A;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pl-detail-crop__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    transform: scale(1.65);
    display: block;
  }

  .pl-detail-crop__placeholder {
    width: 60%;
    height: 70%;
    background: linear-gradient(145deg, #2A3040, #1A1D24);
    border-radius: 4px;
  }

  html[data-theme="dark"] .pl-detail-crop {
    background: #0B0C10;
  }
</style>
