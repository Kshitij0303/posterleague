{% comment %}
  Sticker product gallery — plain PNG on neutral background (no room mockup).
{% endcomment %}
{%- assign sticker_image = product.featured_image -%}

<div class="pl-gallery-sticker" role="img" aria-label="{{ product.title | escape }}">
  {% if sticker_image %}
    <img
      class="pl-gallery-sticker__img pl-artwork-protected"
      src="{{ sticker_image | image_url: width: 1600 }}"
      srcset="{{ sticker_image | image_url: width: 600 }} 600w,
              {{ sticker_image | image_url: width: 900 }} 900w,
              {{ sticker_image | image_url: width: 1200 }} 1200w,
              {{ sticker_image | image_url: width: 1600 }} 1600w"
      sizes="(min-width: 768px) 50vw, 100vw"
      alt="{{ sticker_image.alt | default: product.title | escape }}"
      loading="eager"
      decoding="async"
      width="1200"
      height="1200"
    >
  {% else %}
    <div class="pl-gallery-sticker__placeholder" role="presentation"></div>
  {% endif %}
</div>
