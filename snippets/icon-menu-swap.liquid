{% comment %}
  Menu / close icon swap for mobile nav
  Usage: {% render 'icon-menu-swap', swap_id: 'mobile-menu-icon' %}
{% endcomment %}
{% assign swap_state = swap_state | default: 'a' %}
{% assign icon_size = icon_size | default: 24 %}

<div class="t-icon-swap" data-state="{{ swap_state }}"{% if swap_id != blank %} id="{{ swap_id }}"{% endif %}>
  <span class="t-icon" data-icon="a" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
  </span>
  <span class="t-icon" data-icon="b" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </span>
</div>
